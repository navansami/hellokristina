  "units": [
    {
      "id": "a1-first-conversations",
      "level": "A1",
      "title": "First conversations",
      "subtitle": "Greet, introduce yourself, and read familiar words",
      "outcomes": [
        "Greet and thank someone",
        "Introduce yourself and ask a name",
        "Read familiar words in both Serbian scripts"
      ],
      "lessons": [
        {
          "id": "hello",
          "title": "Say hello",
          "subtitle": "Greet someone with confidence",
          "icon": "👋",
          "color": "green",
          "type": "challenge",
          "theory": {
            "title": "Two ways to write Serbian",
            "body": "Serbian is written in Latin and Cyrillic. Zdravo and Здраво sound the same and both mean hello."
          },
          "vocabulary": [
            {
              "latin": "Zdravo",
              "cyrillic": "Здраво",
              "english": "Hello",
              "pronunciation": "zdrah-voh",
              "audio": "audio/serbian/11a3522b00ae.mp3"
            },
            {
              "latin": "Hvala",
              "cyrillic": "Хвала",
              "english": "Thank you",
              "pronunciation": "hvah-lah",
              "audio": "audio/serbian/5234eca46fe3.mp3"
            },
            {
              "latin": "Dobar dan",
              "cyrillic": "Добар дан",
              "english": "Good day",
              "pronunciation": "doh-bar dahn",
              "audio": "audio/serbian/9b71b25f0e1b.mp3"
            }
          ],
          "challenges": [
            {
              "id": "hello-1",
              "type": "Choose the meaning",
              "prompt": "What does “Zdravo” mean?",
              "answer": "Hello",
              "options": [
                "Goodbye",
                "Please",
                "Hello",
                "Thanks"
              ],
              "explanation": "Zdravo (Здраво) is an everyday hello.",
              "audioText": "Zdravo",
              "audio": "audio/serbian/11a3522b00ae.mp3"
            },
            {
              "id": "hello-2",
              "type": "Translate to Serbian",
              "prompt": "Hello",
              "answer": "Zdravo",
              "options": [
                "Hvala",
                "Zdravo",
                "Da",
                "Ne"
              ],
              "explanation": "Use Zdravo with friends or people you meet.",
              "audioText": "Zdravo",
              "audio": "audio/serbian/11a3522b00ae.mp3"
            },
            {
              "id": "hello-3",
              "type": "Choose the meaning",
              "prompt": "What does “Hvala” mean?",
              "answer": "Thank you",
              "options": [
                "Thank you",
                "Good night",
                "Sorry",
                "Hello"
              ],
              "explanation": "Hvala (Хвала) means thank you.",
              "audioText": "Hvala",
              "audio": "audio/serbian/5234eca46fe3.mp3"
            },
            {
              "id": "hello-4",
              "type": "Arrange the words",
              "prompt": "Good day",
              "answer": "Dobar dan",
              "options": [
                "dan",
                "Dobar",
                "noć",
                "Hvala"
              ],
              "explanation": "Dobar dan is a polite daytime greeting.",
              "audioText": "Dobar dan",
              "audio": "audio/serbian/9b71b25f0e1b.mp3"
            }
          ]
        },
        {
          "id": "introductions",
          "title": "Meet & greet",
          "subtitle": "Say who you are",
          "icon": "💬",
          "color": "blue",
          "type": "challenge",
          "theory": {
            "title": "Introduce yourself",
            "body": "Ja sam means “I am.” Zovem se means “my name is.” In Cyrillic these are Ја сам and Зовем се."
          },
          "vocabulary": [
            {
              "latin": "Ja sam",
              "cyrillic": "Ја сам",
              "english": "I am",
              "pronunciation": "yah sahm",
              "audio": "audio/serbian/32739b0d5c3e.mp3"
            },
            {
              "latin": "Zovem se",
              "cyrillic": "Зовем се",
              "english": "My name is",
              "pronunciation": "zoh-vem seh",
              "audio": "audio/serbian/f00d5734bb60.mp3"
            },
            {
              "latin": "Kako se zoveš?",
              "cyrillic": "Како се зовеш?",
              "english": "What is your name?",
              "pronunciation": "kah-koh seh zoh-vesh",
              "audio": "audio/serbian/b72e2a99e62b.mp3"
            }
          ],
          "challenges": [
            {
              "id": "introductions-1",
              "type": "Choose the meaning",
              "prompt": "Ja sam Kristina.",
              "answer": "I am Kristina.",
              "options": [
                "I am Kristina.",
                "You are Kristina.",
                "Hello Kristina.",
                "Where is Kristina?"
              ],
              "explanation": "Ja sam means I am.",
              "audioText": "Ja sam Kristina.",
              "audio": "audio/serbian/2541ca200d71.mp3"
            },
            {
              "id": "introductions-2",
              "type": "Arrange the words",
              "prompt": "My name is Ana.",
              "answer": "Zovem se Ana",
              "options": [
                "Ana",
                "se",
                "Zovem",
                "Ja",
                "sam"
              ],
              "explanation": "Zovem se is a natural way to give your name.",
              "audioText": "Zovem se Ana.",
              "audio": "audio/serbian/c89bb10e1366.mp3"
            },
            {
              "id": "introductions-3",
              "type": "Choose the meaning",
              "prompt": "Kako se zoveš?",
              "answer": "What is your name?",
              "options": [
                "How are you?",
                "What is your name?",
                "Where are you?",
                "Who is that?"
              ],
              "explanation": "Use this informal question to ask a name.",
              "audioText": "Kako se zoveš?",
              "audio": "audio/serbian/b72e2a99e62b.mp3"
            },
            {
              "id": "introductions-4",
              "type": "Type the answer",
              "prompt": "Write “I am” in Serbian",
              "answer": "Ja sam",
              "options": [],
              "explanation": "Ja sam is written Ја сам in Cyrillic.",
              "audioText": "Ja sam",
              "audio": "audio/serbian/32739b0d5c3e.mp3"
            }
          ]
        },
        {
          "id": "polite",
          "title": "Be polite",
          "subtitle": "Please, thanks, and sorry",
          "icon": "✨",
          "color": "pink",
          "type": "challenge",
          "theory": {
            "title": "Small words, big impact",
            "body": "Molim means “please” and can also mean “you are welcome.” Izvini is an informal “sorry” or “excuse me.”"
          },
          "vocabulary": [
            {
              "latin": "Molim",
              "cyrillic": "Молим",
              "english": "Please",
              "pronunciation": "moh-leem",
              "audio": "audio/serbian/32f01b65767d.mp3"
            },
            {
              "latin": "Izvini",
              "cyrillic": "Извини",
              "english": "Sorry",
              "pronunciation": "eez-vee-nee",
              "audio": "audio/serbian/a19a0ee4c6c4.mp3"
            },
            {
              "latin": "Da",
              "cyrillic": "Да",
              "english": "Yes",
              "pronunciation": "dah",
              "audio": "audio/serbian/2de802b0e746.mp3"
            },
            {
              "latin": "Ne",
              "cyrillic": "Не",
              "english": "No",
              "pronunciation": "neh",
              "audio": "audio/serbian/38cebf4836a9.mp3"
            }
          ],
          "challenges": [
            {
              "id": "polite-1",
              "type": "Translate to Serbian",
              "prompt": "Please",
              "answer": "Molim",
              "options": [
                "Izvini",
                "Molim",
                "Hvala",
                "Ćao"
              ],
              "explanation": "Molim is a useful polite word.",
              "audioText": "Molim",
              "audio": "audio/serbian/32f01b65767d.mp3"
            },
            {
              "id": "polite-2",
              "type": "Choose the meaning",
              "prompt": "Izvini",
              "answer": "Sorry",
              "options": [
                "Please",
                "Goodbye",
                "Sorry",
                "Yes"
              ],
              "explanation": "Izvini is informal. Izvinite is the polite form.",
              "audioText": "Izvini",
              "audio": "audio/serbian/a19a0ee4c6c4.mp3"
            },
            {
              "id": "polite-3",
              "type": "Type the answer",
              "prompt": "Write “thank you” in Serbian",
              "answer": "Hvala",
              "options": [],
              "explanation": "Hvala (Хвала) means thank you.",
              "audioText": "Hvala",
              "audio": "audio/serbian/5234eca46fe3.mp3"
            },
            {
              "id": "polite-4",
              "type": "Choose the meaning",
              "prompt": "Da",
              "answer": "Yes",
              "options": [
                "No",
                "Maybe",
                "Yes",
                "Please"
              ],
              "explanation": "Da means yes; ne means no.",
              "audioText": "Da",
              "audio": "audio/serbian/2de802b0e746.mp3"
            }
          ]
        },
        {
          "id": "script-basics",
          "title": "Read the signs",
          "subtitle": "Connect Cyrillic to Latin",
          "icon": "🔤",
          "color": "purple",
          "type": "challenge",
          "theory": {
            "title": "A letter for each sound",
            "body": "Serbian has 30 Cyrillic letters. A few familiar words show how the scripts line up: Здраво = Zdravo, Хвала = Hvala, Да = Da."
          },
          "vocabulary": [
            {
              "latin": "Zdravo",
              "cyrillic": "Здраво",
              "english": "Hello",
              "pronunciation": "zdrah-voh",
              "audio": "audio/serbian/11a3522b00ae.mp3"
            },
            {
              "latin": "Hvala",
              "cyrillic": "Хвала",
              "english": "Thank you",
              "pronunciation": "hvah-lah",
              "audio": "audio/serbian/5234eca46fe3.mp3"
            },
            {
              "latin": "Da",
              "cyrillic": "Да",
              "english": "Yes",
              "pronunciation": "dah",
              "audio": "audio/serbian/2de802b0e746.mp3"
            }
          ],
          "challenges": [
            {
              "id": "script-basics-1",
              "type": "Choose the meaning",
              "prompt": "Здраво",
              "answer": "Zdravo",
              "options": [
                "Hvala",
                "Zdravo",
                "Molim",
                "Ne"
              ],
              "explanation": "Здраво is Zdravo in Cyrillic.",
              "audioText": "Zdravo",
              "audio": "audio/serbian/11a3522b00ae.mp3"
            },
            {
              "id": "script-basics-2",
              "type": "Choose the meaning",
              "prompt": "Хвала",
              "answer": "Hvala",
              "options": [
                "Dobar dan",
                "Hvala",
                "Ja sam",
                "Da"
              ],
              "explanation": "Хвала is Hvala.",
              "audioText": "Hvala",
              "audio": "audio/serbian/5234eca46fe3.mp3"
            },
            {
              "id": "script-basics-3",
              "type": "Choose the meaning",
              "prompt": "Да",
              "answer": "Da",
              "options": [
                "Da",
                "Ne",
                "Tri",
                "Dan"
              ],
              "explanation": "Да is Da, meaning yes.",
              "audioText": "Da",
              "audio": "audio/serbian/2de802b0e746.mp3"
            },
            {
              "id": "script-basics-4",
              "type": "Type the answer",
              "prompt": "Write Здраво in Latin letters",
              "answer": "Zdravo",
              "options": [],
              "explanation": "The two scripts spell the same Serbian word.",
              "audioText": "Zdravo",
              "audio": "audio/serbian/11a3522b00ae.mp3"
            }
          ]
        },
        {
          "id": "questions",
          "title": "How are you?",
          "subtitle": "Ask and answer simply",
          "icon": "❓",
          "color": "blue",
          "type": "challenge",
          "theory": {
            "title": "A first conversation",
            "body": "Kako si? asks “How are you?” informally. Dobro sam means “I am well.” For a polite or plural question use Kako ste?"
          },
          "vocabulary": [
            {
              "latin": "Kako si?",
              "cyrillic": "Како си?",
              "english": "How are you?",
              "pronunciation": "kah-koh see",
              "audio": "audio/serbian/fdce9d46e038.mp3"
            },
            {
              "latin": "Dobro sam",
              "cyrillic": "Добро сам",
              "english": "I am well",
              "pronunciation": "doh-broh sahm",
              "audio": "audio/serbian/667fab9e03ec.mp3"
            },
            {
              "latin": "Kako ste?",
              "cyrillic": "Како сте?",
              "english": "How are you? (polite)",
              "pronunciation": "kah-koh steh",
              "audio": "audio/serbian/a6f450def0ee.mp3"
            }
          ],
          "challenges": [
            {
              "id": "questions-1",
              "type": "Choose the meaning",
              "prompt": "Kako si?",
              "answer": "How are you?",
              "options": [
                "Where are you?",
                "How are you?",
                "What is your name?",
                "Good day"
              ],
              "explanation": "Kako si? is informal.",
              "audioText": "Kako si?",
              "audio": "audio/serbian/fdce9d46e038.mp3"
            },
            {
              "id": "questions-2",
              "type": "Arrange the words",
              "prompt": "I am well",
              "answer": "Dobro sam",
              "options": [
                "sam",
                "Dobro",
                "Kako",
                "si"
              ],
              "explanation": "Dobro sam is a common reply.",
              "audioText": "Dobro sam",
              "audio": "audio/serbian/667fab9e03ec.mp3"
            },
            {
              "id": "questions-3",
              "type": "Choose the meaning",
              "prompt": "Kako ste?",
              "answer": "How are you? (polite)",
              "options": [
                "How are you? (polite)",
                "What time is it?",
                "Where are we?",
                "What is this?"
              ],
              "explanation": "Use ste when addressing someone politely or more than one person.",
              "audioText": "Kako ste?",
              "audio": "audio/serbian/a6f450def0ee.mp3"
            },
            {
              "id": "questions-4",
              "type": "Type the answer",
              "prompt": "Write “I am well” in Serbian",
              "answer": "Dobro sam",
              "options": [],
              "explanation": "You can answer Kako si? with Dobro sam.",
              "audioText": "Dobro sam",
              "audio": "audio/serbian/667fab9e03ec.mp3"
            }
          ]
        },
