            {
              "id": "unit1-review-3",
              "type": "Translate to Serbian",
              "prompt": "What is your name?",
              "answer": "Kako se zoveš?",
              "options": [
                "Kako si?",
                "Kako se zoveš?",
                "Dobar dan",
                "Ja sam"
              ],
              "explanation": "Kako se zoveš? asks a name informally."
            },
            {
              "id": "unit1-review-4",
              "type": "Type the answer",
              "prompt": "Write “please” in Serbian",
              "answer": "Molim",
              "options": [],
              "explanation": "Molim is one of your most useful polite words."
            }
          ]
        }
      ]
    },
